# ==========================================
# AWS Learner Lab Credentials Template
# Copy this file to .env and fill in values
# from your AWS Learner Lab "AWS Details" modal
# ==========================================

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=ASIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SESSION_TOKEN=IQoJb3JpZ2luX2VjE...[long token]...

# Learner Lab IAM Role
AWS_LAB_ROLE_NAME=LabRole

# Set to true to force simulator mode without contacting AWS
MOCK_AWS=false
